@startuml
actor Learner
participant "VocabularyScreen" as Screen
participant "useVocabulary" as Hook
participant "Local Paper" as Local
participant "Hono Typed Client" as Client
participant "Vocabulary Route" as Route
participant "Better Auth" as Auth
database Prisma

Learner -> Screen : open first paper
Screen -> Local : read local document
alt local document exists
  Local --> Screen : words, round and judgements
else no local document
  Screen --> Learner : show import/input paper
end

Learner -> Screen : judge word known/unknown
Screen -> Local : save current round
alt guest
  Local --> Screen : saved or recoverable failure
else signed in and sync enabled
  Screen -> Hook : record judgement
  Hook -> Client : typed POST /api/vocabulary/:listId/judgements
  Client -> Route : dispatch request
  Route -> Auth : resolve current user
  alt no session
    Auth --> Route : 401
  else owned list
    Route -> Prisma : upsert judgement and session state
    Prisma --> Route : judgement and session
    Route --> Client : 200 { data }
    Client --> Hook : typed response
    Hook --> Screen : sync result
  end
end

Screen --> Learner : render next word or next round
note right of Screen
  The target flow is local-first.
  Account sync is optional and never
  blocks the first learning action.
end note
@enduml
