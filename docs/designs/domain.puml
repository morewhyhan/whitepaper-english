@startuml
hide methods
hide stereotypes

entity user {
  * id : uuid <<PK>>
  --
  * email : string <<unique>>
  * name : string
}

entity vocabularyList <<adopted target>> {
  * id : uuid <<PK>>
  * userId : uuid <<FK>>
  --
  * title : string
  * createdAt : datetime
  * updatedAt : datetime
}

entity vocabularyWord <<adopted target>> {
  * id : uuid <<PK>>
  * listId : uuid <<FK>>
  --
  * text : string
  meaning : string?
  association : string?
  * position : integer
}

entity learningSession <<adopted target>> {
  * id : uuid <<PK>>
  * listId : uuid <<FK>>
  * userId : uuid <<FK>>
  --
  * currentRound : integer
  * status : active|completed
}

entity learningJudgement <<adopted target>> {
  * id : uuid <<PK>>
  * sessionId : uuid <<FK>>
  * wordId : uuid <<FK>>
  --
  * round : integer
  * known : boolean
}

user ||--o{ vocabularyList : owns
vocabularyList ||--o{ vocabularyWord : contains
vocabularyList ||--o{ learningSession : starts
user ||--o{ learningSession : owns
learningSession ||--o{ learningJudgement : records
vocabularyWord ||--o{ learningJudgement : judged

note "The current template still has user -> task.\nThis diagram is the WhitePaper English adoption target." as N
N .. vocabularyList
@enduml
